# FulcrumOS v1.0 Ortam Değişkenleri

# ----------------------------------
# Uygulama Portları
# ----------------------------------
GATEWAY_PORT=8080
ADMIN_UI_PORT=3000

# ----------------------------------
# Veritabanı Bağlantı Bilgileri (MySQL)
# ----------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fulcrumos_db
DB_USER=fulcrum_user
DB_PASSWORD=fulcrum_pass
DB_ROOT_PASSWORD=fulcrum_root_pass

# ----------------------------------
# Mesaj Kuyruğu Bağlantı Bilgileri (RabbitMQ)
# ----------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ----------------------------------
# Harici Servis API Anahtarları
# ----------------------------------
# Ödeme Ağ Geçidi (iyzico)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Yapay Zeka Asistanı (Google Gemini)
GEMINI_API_KEY=

# ----------------------------------
# Diğer Servis Ayarları
# ----------------------------------
# JWT (JSON Web Token) için gizli anahtar
JWT_SECRET=super_secret_key_for_jwt

# Log seviyesi (debug, info, warning, error)
LOG_LEVEL=debug
