# -----------------------------------------------------------------------------
#  FulcrumOS (v10.4) - Çevre Değişkenleri Şablonu
#  Lütfen bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# -----------------------------------------------------------------------------

# Geliştirme Ortamı (development) veya Üretim (production)
APP_ENV=development

# 1. DIŞ PORTLAR (Localhost'ta hangi porttan erişilecek?)
# ---------------------------------------------------
ADMIN_UI_PORT=3000   # Admin Paneli (React): http://localhost:3000
GATEWAY_PORT=8000    # Ana API Gateway: http://localhost:8000/api/...
DB_PORT=33066        # MySQL Erişimi (Dışarıdan): localhost:33066
RABBITMQ_UI_PORT=15672 # RabbitMQ Paneli: http://localhost:15672

# 2. VERİTABANI VE BROKER (Servislerin iç ağı)
# ---------------------------------------------------
# Not: DB_HOST='mysql' ve RABBITMQ_HOST='rabbitmq' olmalıdır.
# Bu isimler docker-compose.yml dosyasındaki servis isimlerinden gelir.

DB_ROOT_PASSWORD=root_sifresi_cok_guclu_olmali
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# 3. MİKROSERVİS VERİTABANI İSİMLERİ (MySQL içinde oluşturulacaklar)
# ---------------------------------------------------
DB_NAME_AUTH=fulcrumos_auth
DB_NAME_ORGANIZASYON=fulcrumos_organizasyon
DB_NAME_KATALOG=fulcrumos_katalog
DB_NAME_ENVANTER=fulcrumos_envanter
DB_NAME_SIPARIS=fulcrumos_siparis
DB_NAME_IADE=fulcrumos_iade
DB_NAME_TEDARIK=fulcrumos_tedarik
DB_NAME_RAPORLAMA=fulcrumos_raporlama
DB_NAME_CMS=fulcrumos_cms
DB_NAME_DESTEK=fulcrumos_destek
DB_NAME_OTOMASYON=fulcrumos_otomasyon
DB_NAME_KUPON=fulcrumos_kupon
DB_NAME_MEDYA=fulcrumos_medya
DB_NAME_AI_ASISTAN=fulcrumos_ai_asistan
DB_NAME_ENTEGRASYON=fulcrumos_entegrasyon
DB_NAME_BILDIRIM=fulcrumos_bildirim # (Gerekirse)

# 4. GÜVENLİK VE 3. PARTİ API ANAHTARLARI
# ---------------------------------------------------
JWT_SECRET_KEY=BURAYA_COK_GUCLU_VE_RASTGELE_BIR_ANAHTAR_GIRIN
CRON_SECRET_KEY=BURAYA_CRON_JOB_ICIN_GUVENLI_BIR_ANAHTAR_GIRIN

# Bu anahtarlar v10.x planına göre artık Organizasyon-Servisi'nde
# veritabanında saklanacak, ancak gerekirse buraya da eklenebilir.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
GEMINI_API_KEY=
MAILER_DSN=smtp://kullanici:sifre@smtp.example.com:587
